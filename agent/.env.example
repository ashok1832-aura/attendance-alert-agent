# Copy to .env and fill in. Settings with a default in src/config/config.py are shown commented out.

# --- Azure AI Foundry (required) -----------------------------------------------
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4

# --- Regulations: Azure AI Search ---------------------------------------------
SEARCH_ENDPOINT=https://<search-service>.search.windows.net
# SEARCH_INDEX_NAME=college-rag
# SEARCH_TYPE=semantic                     # simple | semantic
# SEARCH_TOP_K=5

# --- Students: Azure SQL --------------------------------------------------------
SQL_SERVER=<server>.database.windows.net
# SQL_DATABASE=attendance

# --- Email MCP server ----------------------------------------------------------
EMAIL_MCP_URL=https://<container-app>/mcp
EMAIL_MCP_TOKEN_SCOPE=api://<mcp-app-id>/.default   # empty = no token (local MCP server only)

# --- Local run / deploy ---------------------------------------------------------
AZURE_CREDENTIAL_TYPE=cli                  # cli (az login) | managed_identity | default
LOG_LEVEL=INFO
ACR_NAME=<registry-name-without-.azurecr.io>
IMAGE_TAG=v1
